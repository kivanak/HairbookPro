@model Hairbookpro.Models.Stylist

@{
    ViewBag.Title = "Dodavanje frizera";
}

<section class="admin-form-wrapper">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <span class="home-eyebrow">Administracija</span>
            <h1>Dodavanje frizera</h1>
            <p>Dodajte novog člana Hairbookpro tima.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4" })

            <div class="mb-3">
                <label>Ime i prezime</label>
                @Html.TextBoxFor(m => m.FullName, new
                {
                    @class = "form-control",
                    placeholder = "npr. Ana Petrović"
                })
            </div>

            <div class="mb-3">
                <label>Specijalizacija</label>
                @Html.TextBoxFor(m => m.Specialization, new
                {
                    @class = "form-control",
                    placeholder = "npr. Balayage i koloracija"
                })
            </div>

            <div class="mb-3">
                <label>Biografija</label>
                @Html.TextAreaFor(m => m.Bio, new
                {
                    @class = "form-control",
                    rows = 5,
                    placeholder = "Kratki opis iskustva i rada..."
                })
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.IsActive, new
                {
                    @class = "form-check-input"
                })

                <label class="form-check-label">
                    Aktivan član tima
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary btn-lg">
                    Sačuvaj frizera
                </button>

                <a href='@Url.Action("Index")'
                   class="btn btn-outline-secondary btn-lg">
                    Nazad
                </a>
            </div>
        }
    </div>
</section>