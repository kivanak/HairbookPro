@model IEnumerable<Hairbookpro.Models.Stylist>

@{
    ViewBag.Title = "Administracija frizera";
}

<section class="admin-page-header">
    <div>
        <span class="home-eyebrow">Administracija</span>
        <h1>Upravljanje frizerima</h1>
        <p>Dodavanje, izmjena i upravljanje članovima tima.</p>
    </div>

    <div>
        @Html.ActionLink(
            "➕ Dodaj frizera",
            "Create",
            null,
            new { @class = "btn btn-primary btn-lg" }
        )
    </div>
</section>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Frizer</th>
                    <th>Specijalizacija</th>
                    <th>Status</th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="stylist-avatar-sm">
                                    @s.FullName.Substring(0, 1)
                                </div>

                                <div class="ms-3">
                                    <strong>@s.FullName</strong>

                                    @if (!string.IsNullOrWhiteSpace(s.Bio))
                                    {
                                        <small class="d-block text-muted">
                                            @(s.Bio.Length > 70
                                                ? s.Bio.Substring(0, 70) + "..."
                                                : s.Bio)
                                        </small>
                                    }
                                </div>
                            </div>
                        </td>

                        <td>
                            @s.Specialization
                        </td>

                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge badge-success">
                                    Aktivan
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">
                                    Neaktivan
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            @Html.ActionLink(
                                "Izmijeni",
                                "Edit",
                                new { id = s.Id },
                                new { @class = "btn btn-sm btn-primary me-2" }
                            )

                            <button class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@s.Id">
                                Obriši
                            </button>

                            <div class="modal fade"
                                 id="deleteModal-@s.Id"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content salon-modal">

                                        <div class="modal-header border-0">
                                            <h5 class="modal-title">
                                                Brisanje frizera
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>
                                        </div>

                                        <div class="modal-body">
                                            <p>
                                                Da li ste sigurni da želite obrisati:
                                            </p>

                                            <strong>@s.FullName</strong>
                                        </div>

                                        <div class="modal-footer border-0">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-bs-dismiss="modal">
                                                Otkaži
                                            </button>

                                            @using (Html.BeginForm(
                                                "Delete",
                                                "AdminStylists",
                                                new { id = s.Id },
                                                FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger">
                                                    Obriši
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>