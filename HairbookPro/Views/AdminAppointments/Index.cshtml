@model IEnumerable<Hairbookpro.Models.Appointment>

@{
    ViewBag.Title = "Administracija termina";
}

<section class="admin-page-header">
    <div>
        <span class="home-eyebrow">Administracija</span>
        <h1>Svi zakazani termini</h1>
        <p>Pregled svih termina koje su korisnici zakazali u salonu.</p>
    </div>
</section>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Korisnik</th>
                    <th>Usluga</th>
                    <th>Frizer</th>
                    <th>Datum</th>
                    <th>Status</th>
                    <th>Napomena</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @(a.User != null ? a.User.Email : "Nepoznat korisnik")
                        </td>

                        <td>
                            @(a.Service != null ? a.Service.Name : "Nepoznata usluga")
                        </td>

                        <td>
                            @(a.Stylist != null ? a.Stylist.FullName : "Nepoznat frizer")
                        </td>

                        <td>
                            @a.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            <span class="badge badge-success">
                                @a.Status
                            </span>
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(a.Note) ? "-" : a.Note)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>