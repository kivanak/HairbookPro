@model Hairbookpro.Models.RegisterViewModel

@{
    ViewBag.Title = "Registracija";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <span class="home-eyebrow">Hairbookpro</span>
            <h1>Kreiranje naloga</h1>
            <p>Napravite nalog i brzo zakažite termin u salonu.</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger mb-3" })

            <div class="form-group mb-3">
                <label>Email adresa</label>

                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = "Unesite email adresu"
                })

                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                <label>Lozinka</label>

                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    placeholder = "Unesite lozinku"
                })

                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-4">
                <label>Potvrdite lozinku</label>

                @Html.PasswordFor(m => m.ConfirmPassword, new
                {
                    @class = "form-control",
                    placeholder = "Ponovo unesite lozinku"
                })

                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                Registruj se
            </button>

            <div class="auth-footer">
                <span>Već imate nalog?</span>

                @Html.ActionLink("Prijavite se", "Login", null, new
                {
                    @class = "auth-link"
                })
            </div>
        }
    </div>
</div>