@model Hairbookpro.Models.LoginViewModel

@{
    ViewBag.Title = "Prijava";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <span class="home-eyebrow">Hairbookpro</span>
            <h1>Prijava</h1>
            <p>Prijavite se kako biste zakazali termin i upravljali svojim rezervacijama.</p>
        </div>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="form-group mb-3">
                <label>Email adresa</label>
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = "Unesite email adresu"
                })

                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                <label>Lozinka</label>

                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    placeholder = "Unesite lozinku"
                })

                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })

                <label class="form-check-label">
                    Zapamti me
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                Prijavi se
            </button>

            <div class="auth-footer">
                <span>Nemate nalog?</span>

                @Html.ActionLink("Registrujte se", "Register", null, new
                {
                    @class = "auth-link"
                })
            </div>
        }
    </div>
</div>