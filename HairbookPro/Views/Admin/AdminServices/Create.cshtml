@model Hairbookpro.Models.Service

@{
    ViewBag.Title = "Create Service";
}

<h2>Create Service</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    <div class="form-group">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Description)
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
    </div>
    <div class="form-row">
        <div class="form-group col-md-4">
            @Html.LabelFor(m => m.Price)
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })
        </div>
        <div class="form-group col-md-4">
            @Html.LabelFor(m => m.DurationMinutes)
            @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control" })
        </div>
        <div class="form-group col-md-4">
            @Html.LabelFor(m => m.ServiceCategoryId, "Category")
            @Html.DropDownList("ServiceCategoryId", ViewBag.ServiceCategoryId as SelectList, "Select", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.CheckBoxFor(m => m.IsActive) @Html.LabelFor(m => m.IsActive)
    </div>
    <button class="btn btn-primary" type="submit">Create</button>
}
