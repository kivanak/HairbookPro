@model Hairbookpro.Models.Stylist

@{
    ViewBag.Title = "Edit Stylist";
}

<h2>Edit Stylist</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="form-group">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Specialization)
        @Html.TextBoxFor(m => m.Specialization, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Bio)
        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4 })
    </div>
    <div class="form-group">
        @Html.CheckBoxFor(m => m.IsActive) @Html.LabelFor(m => m.IsActive)
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
}
