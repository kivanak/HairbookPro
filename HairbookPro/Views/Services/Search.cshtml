@model HairBookPro.Models.ServiceSearchViewModel
@{
    ViewBag.Title = "Detaljna pretraga";
}

<div class="container mt-4">
    <h2>Detaljna pretraga usluga</h2>

    @using (Html.BeginForm("Search", "Services", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-4 mb-3">
                @Html.LabelFor(m => m.Query)
                @Html.TextBoxFor(m => m.Query, new { @class = "form-control" })
            </div>

            <div class="col-md-4 mb-3">
                <label>Kategorija</label>
                @Html.DropDownList("CategoryId", null, "Sve kategorije", new { @class = "form-control" })
            </div>

            <div class="col-md-2 mb-3">
                @Html.LabelFor(m => m.MinPrice)
                @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", type = "number", step = "0.01" })
            </div>

            <div class="col-md-2 mb-3">
                @Html.LabelFor(m => m.MaxPrice)
                @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", type = "number", step = "0.01" })
            </div>
        </div>

        <button class="btn btn-primary">Pretraži</button>
    }

    @if (Model.Results != null)
    {
        <hr />
        <h4>Rezultati</h4>
        <div class="row">
            @foreach (var item in Model.Results)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5>@item.Name</h5>
                            <p>@item.Description</p>
                            <strong>@item.Price.ToString("0.00") €</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
