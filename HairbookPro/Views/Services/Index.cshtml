@model IEnumerable<Hairbookpro.Models.Service>

@{
    ViewBag.Title = "Usluge";
}

<section class="page-header salon-page-header">
    <span class="home-eyebrow">Naša ponuda</span>
    <h1>Usluge salona</h1>
    <p>Pronađite uslugu koja vam odgovara i zakažite termin kod našeg tima frizera.</p>
</section>

<section class="search-panel">
    @using (Html.BeginForm("Index", "Services", FormMethod.Get))
    {
        <div class="services-search-row">
            <input type="text"
                   name="q"
                   value="@ViewBag.Query"
                   class="form-control"
                   placeholder="Pretražite usluge, npr. šišanje, farbanje, keratin..." />

            <button class="btn btn-primary" type="submit">Pretraži</button>

            @Html.ActionLink("Detaljna pretraga", "Search", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</section>

<section class="services-grid">
    @foreach (var item in Model)
    {
        <div class="service-card-modern">
            <div class="service-card-modern__top">
                <span>✂</span>
                <strong>@item.DurationMinutes min</strong>
            </div>

            <h3>@item.Name</h3>
            <p>@item.Description</p>

            <div class="service-card-modern__bottom">
                <strong>@item.Price.ToString("0.00") €</strong>
                @Html.ActionLink("Detalji", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-primary" })
            </div>
        </div>
    }
</section>