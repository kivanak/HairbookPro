@model IEnumerable<Hairbookpro.Models.Appointment>
@{
    ViewBag.Title = "Moji termini";
}

<div class="container mt-4">
    <h2>Moji termini</h2>
    @Html.ActionLink("Novi termin", "Create", null, new { @class = "btn btn-primary mb-3" })

    <div class="appointments-summary-card">
        <span class="home-eyebrow">Statistika</span>

        <h2>Ukupan broj vaših termina</h2>

        <div class="appointments-total-number">
            @ViewBag.TotalAppointments
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <tr>
                <th>Usluga</th>
                <th>Frizer</th>
                <th>Datum</th>
                <th>Status</th>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Service.Name</td>
                    <td>@item.Stylist.FullName</td>
                    <td>@item.AppointmentDate</td>
                    <td>@item.Status</td>
                </tr>
            }
        </table>
    </div>
</div>
