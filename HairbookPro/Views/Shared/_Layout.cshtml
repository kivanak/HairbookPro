<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HairBookPro</title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light salon-navbar">
        <div class="container">
            <a href="@Url.Action("Index","Home")"
               class="navbar-brand"
               style="color:#8f4d58 !important; font-weight:800; font-size:26px;">
                Hair<span style="color:#b76e79;">Book</span>Pro
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">@Html.ActionLink("Početna", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Usluge", "Index", "Services", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Frizeri", "Index", "Stylists", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Blog", "Index", "Blog", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Moji termini", "Index", "Appointments", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>

                <div class="d-flex align-items-center">
                    @if (User != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <ul class="navbar-nav mr-3">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle admin-link" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown">
                                    Administracija
                                </a>

                                <div class="dropdown-menu dropdown-menu-end salon-dropdown" aria-labelledby="adminMenu">
                                    <a class="dropdown-item" href='@Url.Action("Index","AdminServices")'>Usluge</a>
                                    <a class="dropdown-item" href='@Url.Action("Index","AdminBlogPosts")'>Blog objave</a>
                                    <a class="dropdown-item" href='@Url.Action("Index","AdminStylists")'>Frizeri</a>
                                    <a class="dropdown-item" href='@Url.Action("Index","AdminContacts")'>Poruke korisnika</a>
                                </div>
                            </li>
                        </ul>
                    }

                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="container body-content">
        @RenderBody()
    </main>

    <footer class="salon-footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year HairBookPro — frizerski salon i online zakazivanje termina.</p>
        </div>
    </footer>

    <script src="@Url.Content("~/Scripts/jquery-3.7.0.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>