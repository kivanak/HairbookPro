@model Hairbookpro.Models.BlogPost

@{
    ViewBag.Title = Model.Title;
}

<section class="blog-details">
    <div class="blog-details-card">
        <span class="blog-category">
            @(Model.BlogCategory != null ? Model.BlogCategory.Name : "Blog")
        </span>

        <h1>@Model.Title</h1>

        <div class="blog-meta mb-4">
            <span>📅 @Model.CreatedAt.ToString("dd.MM.yyyy")</span>
        </div>

        <div class="blog-content">
            @Model.Content
        </div>
    </div>
</section>

<section class="comments-section">
    <div class="comments-card">
        <h3>Komentari</h3>

        @if (Model.Comments != null && Model.Comments.Any())
        {
            foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
            {
                <div class="comment-modern">
                    <div class="comment-modern__top">
                        <div>
                            <strong>
                                @(comment.User != null ? comment.User.Email : "Nepoznat korisnik")
                            </strong>

                            <span class="comment-date">
                                @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                    </div>

                    <p>@comment.Content</p>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Nema komentara.</p>
        }

        @if (User.Identity.IsAuthenticated)
        {
            <hr />

            <h4>Dodajte komentar</h4>

            using (Html.BeginForm("AddComment", "Blog", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.Hidden("blogPostId", Model.Id)

                <div class="form-group mb-3">
                    <textarea name="content"
                              class="form-control"
                              rows="5"
                              placeholder="Unesite komentar..."></textarea>
                </div>

                <button class="btn btn-primary">
                    Objavi komentar
                </button>
            }
        }
        else
        {
            <div class="alert alert-light mt-4">
                Morate biti prijavljeni kako biste komentarisali.
            </div>
        }
    </div>
</section>