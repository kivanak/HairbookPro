@model IEnumerable<Hairbookpro.Models.Stylist>

@{
    ViewBag.Title = "Frizeri";
}

<section class="page-header salon-page-header">
    <span class="home-eyebrow">Naš tim</span>

    <h1>Upoznajte naše frizere</h1>

    <p>
        Profesionalni tim HairBookPro salona sa iskustvom u šišanju,
        bojenju, stilizovanju i tretmanima za njegu kose.
    </p>
</section>

<section class="stylists-grid">
    @foreach (var stylist in Model)
    {
        <div class="stylist-card-modern">
            <div class="stylist-avatar">
                @stylist.FullName.Substring(0, 1)
            </div>

            <h3>@stylist.FullName</h3>

            <span class="stylist-specialization">
                @stylist.Specialization
            </span>

            <p>
                @stylist.Bio
            </p>

            <div class="stylist-actions">
                <a href='@Url.Action("Create", "Appointments")'
                   class="btn btn-primary btn-sm">
                    Zakaži termin
                </a>
            </div>
        </div>
    }
</section>