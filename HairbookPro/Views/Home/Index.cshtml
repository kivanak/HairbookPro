@{
    ViewBag.Title = "Home";
}

<header class="hero py-5 text-white bg-primary text-center">
    <div class="container">
        <h1 class="display-4">HairBookPro</h1>
        <p class="lead">Profesionalne frizerske usluge — rezervirajte online, upoznajte naše stiliste.</p>
        <p><a href='@Url.Action("Index", "Services")' class="btn btn-light btn-lg">Pregled usluga</a></p>
    </div>
</header>

<main class="container py-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Usluge</h2>
            <p>Brz pregled najpopularnijih usluga i jednostavno zakazivanje.</p>
            <ul>
                <li>Ženski šišanje</li>
                <li>Muški šišanje</li>
                <li>Boje i pramenovi</li>
                <li>Keratin tretman</li>
            </ul>
            <p><a href='@Url.Action("Index", "Services")' class="btn btn-primary">Pogledaj sve usluge</a></p>
        </div>
        <div class="col-md-6">
            <h2>Upoznajte stiliste</h2>
            <p>Iskusni profesionalci koji brinu o vašem izgledu.</p>
            <p><a href='@Url.Action("Index", "Stylists")' class="btn btn-outline-primary">Upoznajte tim</a></p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h3>Najnovije s bloga</h3>
            <article class="mb-3">
                <h4>Top ljetne frizure</h4>
                <p class="text-muted">Kratki savjeti kako održati kosu zdravom i modernom ovog ljeta.</p>
                <p><a href='@Url.Action("Index", "Blog")' class="btn btn-sm btn-outline-secondary">Pročitaj više</a></p>
            </article>
        </div>
        <aside class="col-md-4">
            <h3>Kontakt</h3>
            <p>Treba li vam pomoć pri zakazivanju ili imate pitanje? <a href='@Url.Action("Contact", "Home")'>Kontaktirajte nas</a>.</p>
            <p><a href='@Url.Action("Contact", "Home")' class="btn btn-primary">Pošalji poruku</a></p>
        </aside>
    </div>
</main>

<section class="bg-light py-4">
    <div class="container text-center">
        <h4>Spremni za novi izgled?</h4>
        <p><a href='@Url.Action("Create", "Appointments")' class="btn btn-success">Rezerviraj termin</a></p>
    </div>
</section>
