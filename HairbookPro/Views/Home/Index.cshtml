@{
    ViewBag.Title = "Home";
}

<section class="hero">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row align-items-center hero-content text-center text-md-left">
            <div class="col-md-7 text-white">
                <h1 class="display-4">HairBookPro</h1>
                <p class="lead">Profesionalne frizerske usluge — rezervirajte online, upoznajte naše stiliste.</p>
                <p class="mb-4">
                    <a href='@Url.Action("Index", "Services")' class="btn btn-light btn-lg mr-2">Pregled usluga</a>
                    <a href='@Url.Action("Create", "Appointments")' class="btn btn-outline-light btn-lg">Rezerviši termin</a>
                </p>
            </div>
            <div class="col-md-5">
                <div class="card shadow-sm booking-card">
                    <div class="card-body">
                        <h5 class="card-title">Brzo zakazivanje</h5>
                        <form action='@Url.Action("Create", "Appointments")' method="get">
                            <div class="form-group">
                                <label class="sr-only">Usluga</label>
                                <select class="form-control" name="ServiceId">
                                    <option value="">Izaberite uslugu</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="sr-only">Datum</label>
                                <input class="form-control" type="date" name="Date" />
                            </div>
                            <button class="btn btn-primary btn-block">Počni rezervaciju</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<main class="container py-5">
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Popularne usluge</h2>
            <a class="btn btn-link" href='@Url.Action("Index", "Services")'>Pogledaj sve</a>
        </div>
        <div class="row">
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="card h-100 service-card">
                    <div class="card-body">
                        <h5 class="card-title">Žensko šišanje</h5>
                        <p class="card-text">Profesionalno šišanje i stilizovanje.</p>
                    </div>
                    <div class="card-footer bg-white">
                        <small class="text-muted">45 min • 20 €</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="card h-100 service-card">
                    <div class="card-body">
                        <h5 class="card-title">Muško šišanje</h5>
                        <p class="card-text">Klasično i moderno šišanje.</p>
                    </div>
                    <div class="card-footer bg-white">
                        <small class="text-muted">30 min • 12 €</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="card h-100 service-card">
                    <div class="card-body">
                        <h5 class="card-title">Balayage</h5>
                        <p class="card-text">Moderna tehnika bojenja za prirodan izgled.</p>
                    </div>
                    <div class="card-footer bg-white">
                        <small class="text-muted">180 min • 80 €</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="card h-100 service-card">
                    <div class="card-body">
                        <h5 class="card-title">Keratin tretman</h5>
                        <p class="card-text">Obnova i zaglađivanje kose.</p>
                    </div>
                    <div class="card-footer bg-white">
                        <small class="text-muted">120 min • 60 €</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Upoznajte naše stiliste</h2>
            <a class="btn btn-link" href='@Url.Action("Index", "Stylists")'>Upoznajte tim</a>
        </div>
        <div class="row">
            <div class="col-sm-6 col-md-4 mb-4">
                <div class="card h-100 stylist-card">
                    <div class="card-body">
                        <h5 class="card-title">Ana Petrović</h5>
                        <p class="card-text">Šišanje i feniranje — 8 godina iskustva</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 mb-4">
                <div class="card h-100 stylist-card">
                    <div class="card-body">
                        <h5 class="card-title">Marko Jovanović</h5>
                        <p class="card-text">Specijalista za bojenje — balayage &amp; color</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4 mb-4">
                <div class="card h-100 stylist-card">
                    <div class="card-body">
                        <h5 class="card-title">Milica Kovač</h5>
                        <p class="card-text">Tretmani i obnova kose</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <h2>Iz bloga</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Kako njegovati kosu tokom ljeta</h5>
                        <p class="card-text text-muted">Koristite hidratantne maske i zaštitu od sunca...</p>
                        <a href='@Url.Action("Index", "Blog")' class="btn btn-sm btn-outline-secondary">Pročitaj</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Top frizure ove sezone</h5>
                        <p class="card-text text-muted">Prirodni talasi i slojevito šišanje dominiraju...</p>
                        <a href='@Url.Action("Index", "Blog")' class="btn btn-sm btn-outline-secondary">Pročitaj</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="text-center py-5 cta-section">
        <h3>Spremni za promjenu?</h3>
        <p><a href='@Url.Action("Create", "Appointments")' class="btn btn-success btn-lg">Rezerviši termin</a></p>
    </section>
</main>
