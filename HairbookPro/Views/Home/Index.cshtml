@{
    ViewBag.Title = "Početna";
}

<section class="home-hero">
    <div class="home-hero__content">
        <span class="home-eyebrow">Frizerski salon & online zakazivanje</span>

        <h1>Ljepota kose počinje dobrim terminom.</h1>

        <p>
            HairBookPro vam omogućava da pregledate usluge, upoznate naš tim frizera
            i brzo zakažete termin u salonu.
        </p>

        <div class="home-hero__actions">
            <a href='@Url.Action("Index", "Services")' class="btn btn-primary btn-lg">Pogledaj usluge</a>
            <a href='@Url.Action("Create", "Appointments")' class="btn btn-outline-secondary btn-lg">Zakaži termin</a>
        </div>
    </div>

    <div class="home-booking-card">
        <h5>Brzo zakazivanje</h5>
        <p>Izaberite uslugu i datum, a zatim nastavite na formu za termin.</p>

        <form action='@Url.Action("Create", "Appointments")' method="get">
            <div class="form-group">
                <label>Usluga</label>
                <select class="form-control" name="ServiceId">
                    <option value="">Izaberite uslugu</option>
                </select>
            </div>

            <div class="form-group">
                <label>Datum</label>
                <input class="form-control" type="date" name="Date" />
            </div>

            <button class="btn btn-primary btn-block">Nastavi zakazivanje</button>
        </form>
    </div>
</section>

<main class="home-content">
    <section class="home-section">
        <div class="home-section__header">
            <div>
                <span class="home-eyebrow">Naša ponuda</span>
                <h2>Popularne usluge</h2>
            </div>
            <a href='@Url.Action("Index", "Services")' class="btn btn-outline-secondary">Pogledaj sve</a>
        </div>

        <div class="home-grid home-grid--four">
            <div class="home-card">
                <div class="home-card__icon">✂</div>
                <h5>Žensko šišanje</h5>
                <p>Profesionalno šišanje i stilizovanje prema obliku lica.</p>
                <span>45 min • 20 €</span>
            </div>

            <div class="home-card">
                <div class="home-card__icon">💈</div>
                <h5>Muško šišanje</h5>
                <p>Klasično i moderno šišanje uz preciznu završnu obradu.</p>
                <span>30 min • 12 €</span>
            </div>

            <div class="home-card">
                <div class="home-card__icon">🎨</div>
                <h5>Balayage</h5>
                <p>Moderna tehnika bojenja za prirodan i elegantan izgled.</p>
                <span>180 min • 80 €</span>
            </div>

            <div class="home-card">
                <div class="home-card__icon">✨</div>
                <h5>Keratin tretman</h5>
                <p>Obnova, zaglađivanje i dubinska njega oštećene kose.</p>
                <span>120 min • 60 €</span>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section__header">
            <div>
                <span class="home-eyebrow">Naš tim</span>
                <h2>Upoznajte frizere</h2>
            </div>
            <a href='@Url.Action("Index", "Stylists")' class="btn btn-outline-secondary">Upoznajte tim</a>
        </div>

        <div class="home-grid home-grid--three">
            <div class="home-card stylist-card">
                <h5>Ana Petrović</h5>
                <p>Šišanje i feniranje — 8 godina iskustva.</p>
            </div>

            <div class="home-card stylist-card">
                <h5>Marko Jovanović</h5>
                <p>Specijalista za bojenje, balayage i moderne color tehnike.</p>
            </div>

            <div class="home-card stylist-card">
                <h5>Milica Kovač</h5>
                <p>Tretmani, njega i obnova oštećene kose.</p>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section__header">
            <div>
                <span class="home-eyebrow">Savjeti i inspiracija</span>
                <h2>Iz bloga</h2>
            </div>
            <a href='@Url.Action("Index", "Blog")' class="btn btn-outline-secondary">Svi tekstovi</a>
        </div>

        <div class="home-grid home-grid--two">
            <div class="home-card">
                <h5>Kako njegovati kosu tokom ljeta</h5>
                <p>Koristite hidratantne maske, zaštitu od sunca i redovno skraćujte krajeve.</p>
                <a href='@Url.Action("Index", "Blog")' class="btn btn-sm btn-primary">Pročitaj</a>
            </div>

            <div class="home-card">
                <h5>Top frizure ove sezone</h5>
                <p>Prirodni talasi, slojevito šišanje i nježne nijanse dominiraju ove sezone.</p>
                <a href='@Url.Action("Index", "Blog")' class="btn btn-sm btn-primary">Pročitaj</a>
            </div>
        </div>
    </section>

    <section class="home-cta">
        <span class="home-eyebrow">Spremni za promjenu?</span>
        <h3>Zakažite termin i prepustite kosu stručnom timu.</h3>
        <a href='@Url.Action("Create", "Appointments")' class="btn btn-primary btn-lg">Zakaži termin</a>
    </section>
</main>