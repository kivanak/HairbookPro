@model IEnumerable<Hairbookpro.Models.BlogPost>

@{
    ViewBag.Title = "Manage Blog Posts";
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "AdminDashboard")">Admin</a></li>
    <li class="breadcrumb-item active" aria-current="page">Blog Posts</li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Blog Posts</h2>
    <p class="mb-0">@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>
 </div>

<div class="card">
  <div class="card-body">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach(var p in Model){
            <tr>
                <td>@p.Title</td>
                <td>@(p.BlogCategory != null ? p.BlogCategory.Name : "")</td>
                <td>@p.CreatedAt.ToString("g")</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = p.Id }, new { @class = "btn btn-sm btn-outline-secondary mr-2" })
                    @Html.ActionLink("Delete", "Delete", new { id = p.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
      </tbody>
    </table>
  </div>
</div>
