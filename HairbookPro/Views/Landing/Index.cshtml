@{
    ViewBag.Title = "Home";
}

<section class="hero py-5 text-center text-white bg-primary">
    <div class="container">
        <h1 class="display-5">Welcome to Hairbookpro</h1>
        <p class="lead">Professional hair services — book online, meet top stylists.</p>
        <p><a href="/Services" class="btn btn-light btn-lg">View Services</a></p>
    </div>
</section>

<section class="container py-5">
    <div class="row">
        <div class="col-md-6">
            <h2>Our Services</h2>
            <p>Quick access to popular services and easy booking.</p>
            <ul>
                <li>Women's Haircut</li>
                <li>Men's Haircut</li>
                <li>Coloring &amp; Highlights</li>
                <li>Keratin Treatment</li>
            </ul>
            <p><a href="/Services" class="btn btn-primary">See all services</a></p>
        </div>
        <div class="col-md-6">
            <h2>Meet Our Stylists</h2>
            <p>Experienced professionals who care about your look.</p>
            <p><a href="/Stylists" class="btn btn-outline-primary">Meet the team</a></p>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container text-center">
        <h3>Get in touch</h3>
        <p>Email us or send a message through the contact form.</p>
        <p><a href="/Contact" class="btn btn-primary">Contact us</a></p>
    </div>
</section>
