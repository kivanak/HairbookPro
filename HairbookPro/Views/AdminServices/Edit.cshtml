@model Hairbookpro.Models.Service

@{
    ViewBag.Title = "Izmjena usluge";
}

<section class="admin-form-wrapper">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <span class="home-eyebrow">Administracija</span>
            <h1>Izmjena usluge</h1>
            <p>Izmijenite podatke o usluzi frizerskog salona.</p>
        </div>

        @using (Html.BeginForm("Edit", "AdminServices", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4" })

            <div class="mb-3">
                <label>Naziv usluge</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "npr. Keratin tretman" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label>Opis</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5, placeholder = "Unesite opis usluge..." })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label>Cijena (€)</label>
                    @Html.TextBoxFor(m => m.Price, new
{
    @class = "form-control",
    type = "text"
})
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4 mb-3">
                    <label>Trajanje (min)</label>
                    @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.DurationMinutes, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4 mb-3">
                    <label>Kategorija</label>
                    @Html.DropDownList("ServiceCategoryId", null, "Izaberite kategoriju", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ServiceCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                <label class="form-check-label">Aktivna usluga</label>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary btn-lg">
                    Sačuvaj izmjene
                </button>

                <a href='@Url.Action("Index")' class="btn btn-outline-secondary btn-lg">
                    Nazad
                </a>
            </div>
        }
    </div>
</section>