@model Hairbookpro.Models.Service

@{
    ViewBag.Title = "Dodavanje usluge";
}

<section class="admin-form-wrapper">
    <div class="admin-form-card">
        <div class="admin-form-header">
            <span class="home-eyebrow">Administracija</span>
            <h1>Dodavanje nove usluge</h1>
            <p>Dodajte novu uslugu frizerskog salona.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4" })

            <div class="mb-3">
                <label>Naziv usluge</label>
                @Html.TextBoxFor(m => m.Name, new
                {
                    @class = "form-control",
                    placeholder = "npr. Keratin tretman"
                })
            </div>

            <div class="mb-3">
                <label>Opis</label>
                @Html.TextAreaFor(m => m.Description, new
                {
                    @class = "form-control",
                    rows = 5,
                    placeholder = "Unesite opis usluge..."
                })
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label>Cijena (€)</label>
                    @Html.TextBoxFor(m => m.Price, new
                    {
                        @class = "form-control",
                        type = "number",
                        step = "0.01"
                    })
                </div>

                <div class="col-md-4 mb-3">
                    <label>Trajanje (min)</label>
                    @Html.TextBoxFor(m => m.DurationMinutes, new
                    {
                        @class = "form-control",
                        type = "number"
                    })
                </div>

                <div class="col-md-4 mb-3">
                    <label>Kategorija</label>
                    @Html.DropDownList(
                        "ServiceCategoryId",
                        null,
                        "Izaberite kategoriju",
                        new { @class = "form-control" }
                    )
                </div>
            </div>

            <div class="form-check mb-4">
                @Html.CheckBoxFor(m => m.IsActive, new
                {
                    @class = "form-check-input"
                })

                <label class="form-check-label">
                    Aktivna usluga
                </label>
            </div>

            <div class="admin-form-actions">
                <button class="btn btn-primary btn-lg">
                    Sačuvaj uslugu
                </button>

                <a href='@Url.Action("Index")'
                   class="btn btn-outline-secondary btn-lg">
                    Nazad
                </a>
            </div>
        }
    </div>
</section>